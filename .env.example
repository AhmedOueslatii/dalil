# En local : Docker Compose mappe le port hôte 5433 -> 5432 dans le conteneur.
# En production (Render) : URL du Session pooler Supabase (IPv4), pas la connexion
# directe (IPv6-only, ne résout pas sur tous les réseaux).
DATABASE_URL=postgresql://dalil:dalil@localhost:5433/dalil
EMBEDDING_DIM=768
APP_ENV=dev

GEMINI_API_KEY=
MISTRAL_API_KEY=

# Settings → API sur le dashboard Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
